<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="15" styleClass="login-container"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="uam.evote.controller.VoteFormController">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <Label fx:id="titreElectionLabel" styleClass="titre" />
    <Label text="Sélectionnez votre candidat, puis confirmez votre vote." styleClass="sous-titre" />

    <ScrollPane fitToWidth="true" prefHeight="300">
        <VBox fx:id="candidatsContainer" spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10" />
            </padding>
        </VBox>
    </ScrollPane>

    <Label fx:id="messageErreur" styleClass="message-erreur" visible="false" managed="false" />

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Annuler" onAction="#handleAnnuler" />
        <Button text="Confirmer mon vote" onAction="#handleConfirmer" styleClass="bouton-principal" />
    </HBox>

</VBox>